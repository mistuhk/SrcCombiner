
<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="SliverLayerPickerLabelStyle" TargetType="Label">
        <Setter Property="Text" Value="Select layer to search sliver areas"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"/>
        <Setter Property="Margin" Value="10,5,0,0"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="SliverLayerPickerStyle" TargetType="Picker">        
        <Setter Property="Margin" Value="10,5,0,0"/>
        <Setter Property="WidthRequest" Value="200"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="ItemsSource" Value="{Binding Layers}"/>
        <Setter Property="SelectedItem" Value="{Binding SelectedLayer, Mode=TwoWay}"/>
    </Style>

    <Style x:Key="SliverAreaContentStackLayoutStyle" TargetType="StackLayout">
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="IsVisible" Value="{Binding IsSliverAreaBrowserVisible}"/>
    </Style>

    <Style x:Key="SliverAreaContentScrollViewStyle" TargetType="ScrollView">
        <Setter Property="Orientation" Value="Both"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="HeightRequest" Value="190"/>
        <Setter Property="Margin" Value="0,5,0,0"/>        
    </Style>

    <Style x:Key="SliverAreaContentCollectionViewStyle" TargetType="CollectionView">        
        <Setter Property="VerticalScrollBarVisibility" Value="Always"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ItemsSource" Value="{Binding SliverAreas}"/>
        <Setter Property="SelectedItem" Value="{Binding SelectedItem, Mode=TwoWay}"/>
        <Setter Property="SelectionChangedCommand" Value="{Binding ItemSelectedCommand}"/>
    </Style>

    <Style x:Key="SliverAreaHeaderLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="Padding" Value="0,0,10,0"/>
    </Style>
    <Style x:Key="SliverAreaDataLabel" TargetType="Label">
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,5,10,5"/>
    </Style>

</ResourceDictionary>
