
<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">   

    <Style x:Key="TopologicalChecksTotalCountStyle" TargetType="Label">
        <Setter Property="Text" Value="{Binding TotalCount, StringFormat='Total No. of Topological Error(s): {0}'}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"/>
    </Style>

    <Style x:Key="TopologicalChecksLabelBoxViewtyle" TargetType="BoxView">
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BorderStrongLight}, Dark={StaticResource BorderStrongDark}}"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    
    <Style x:Key="TopologicalCheckBrowserScrollViewStyle" TargetType="ScrollView">
        <Setter Property="Orientation" Value="Both"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="HeightRequest" Value="190"/>
        <Setter Property="Margin" Value="0,5,0,0"/>        
    </Style>
    
    <Style x:Key="TopologicalCheckBrowserCollectionViewStyle" TargetType="CollectionView">
        <Setter Property="Grid.Row" Value="0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Always"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Always"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ItemsSource" Value="{Binding TopologicalErrors}"/>
        <Setter Property="SelectedItem" Value="{Binding SelectedItem, Mode=TwoWay}"/>
        <Setter Property="SelectionChangedCommand" Value="{Binding ItemSelectedCommand}"/>
    </Style>    

    <Style x:Key="TopologicalCheckCollectionViewHeaderGridStyle" TargetType="Grid">
        <Setter Property="Grid.ColumnDefinitions" Value="80,100,150,400,175,200,120,120,AUTO"/>
        <Setter Property="Padding" Value="0,10,0,10"/>
    </Style>
    
    <Style x:Key="TopologicalCheckCollectionViewHeaderLabelStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"/>
    </Style>

    <Style x:Key="TopologicalCheckCollectionViewDataGridStyle" TargetType="Grid">
        <Setter Property="Grid.ColumnDefinitions" Value="80,100,150,400,175,200,120,120,AUTO"/>
        <Setter Property="Padding" Value="0,5,0,5"/>        
    </Style>

</ResourceDictionary>
