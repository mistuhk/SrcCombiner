diff --git a/Tests/MiEditor.Core.Tests/Services/Drawing/Editing/History/EditHistoryServiceTests.cs b/Tests/MiEditor.Core.Tests/Services/Drawing/Editing/History/EditHistoryServiceTests.cs
new file mode 100644
index 0000000..2663224
