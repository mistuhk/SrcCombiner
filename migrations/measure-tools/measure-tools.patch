@@ -0,0 +1,47 @@
+using WG.MiEditor.Core.Services.Drawing.Measurement.Context;
+using WG.MiEditor.Core.Services.Notifications;
+using WG.MiEditor.Logging.Abstractions;
+using WG.MiEditor.Shared.AutoScanning;
+using WG.MiEditor.Shared.Models.Notifications;
+
+namespace WG.MiEditor.Core.Services.Drawing.Measurement.Components;
+
+public interface IMeasurementErrorReporter
+{
+    /// <summary>Logs <paramref name="exception"/> and tells the user, without ever throwing.</summary>
+    void Report(string title, Exception exception);
+}
+
+/// <summary>
+/// Single place where measurement failures are logged and surfaced. Used from map event handlers,
+/// where an unhandled exception would otherwise take the app down.
+/// </summary>
+[RegisterService(ServiceLifetime.Singleton, As = new[] { typeof(IMeasurementErrorReporter) })]
+public sealed class MeasurementErrorReporter(
+    ILoggerService logger,
+    INotificationManager notificationManager) : IMeasurementErrorReporter
+{
+    public const string GenericMessage = "Something went wrong with the measurement. Please try again.";
+
+    public void Report(string title, Exception exception)
+    {
+        try
+        {
+            logger.Error(exception, $"{title} failed.");
+        }
+        catch
+        {
+            // Logging must never turn a handled failure into an unhandled one.
+        }
+
+        try
+        {
+            var message = exception is MeasurementUnavailableException ? exception.Message : GenericMessage;
+            notificationManager.Show(title, message, NotificationType.Error);
+        }
+        catch
+        {
+            // As above: reporting is best effort.
+        }
+    }
+}
diff -ruN a/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementGeometry.cs b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementGeometry.cs
--- /dev/null
+++ b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementGeometry.cs
@@ -0,0 +1,61 @@
+using Esri.ArcGISRuntime.Geometry;
+using WG.MiEditor.Shared.Messages.Measurement;
+
+namespace WG.MiEditor.Core.Services.Drawing.Measurement.Components;
+
+/// <summary>Pure geometry rules shared by the measure tools.</summary>
+public static class MeasurementGeometry
+{
+    /// <summary>
+    /// True when the geometry has at least <paramref name="minVertexCount"/> vertices in its first
+    /// part. Null, empty and part-less geometries are never valid.
+    /// </summary>
+    public static bool HasMinimumVertices(Geometry? geometry, int minVertexCount)
+    {
+        if (geometry is null || geometry.IsEmpty) return false;
+
+        var parts = geometry switch
+        {
+            Polyline line => line.Parts,
+            Polygon polygon => polygon.Parts,
+            _ => null
+        };
+
+        if (parts is null) return true;
+
+        return parts.Count > 0 && parts[0].PointCount >= minVertexCount;
+    }
+
+    /// <summary>
+    /// Geodesic length (and area, for polygons) in metres and square metres. Lines and polygons
+    /// always produce a reading, zero while too few vertices exist, so the live panel never keeps
+    /// showing a stale value after the user undoes vertices. Null only for null geometry or types
+    /// that have no length.
+    /// </summary>
+    public static DrawingProgressMessage? Measure(Geometry? geometry)
+    {
+        switch (geometry)
+        {
+            case Polyline line:
+                return new DrawingProgressMessage(
+                    line.IsEmpty ? 0 : Finite(line.LengthGeodetic(LinearUnits.Meters, GeodeticCurveType.Geodesic)),
+                    null);
+
+            case Polygon polygon:
+                return polygon.IsEmpty
+                    ? new DrawingProgressMessage(0, 0)
+                    : new DrawingProgressMessage(
+                        Finite(polygon.LengthGeodetic(LinearUnits.Meters, GeodeticCurveType.Geodesic)),
+                        Finite(polygon.AreaGeodetic(AreaUnits.SquareMeters, GeodeticCurveType.Geodesic)));
+
+            default:
+                return null;
+        }
+    }
+
+    /// <summary>The zero reading for a sketch of <paramref name="geometryType"/> with no vertices.</summary>
+    public static DrawingProgressMessage Empty(GeometryType geometryType) =>
+        new(0, geometryType == GeometryType.Polygon ? 0 : null);
+
+    private static double Finite(double value) => double.IsFinite(value) && value > 0 ? value : 0;
+}
diff -ruN a/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementResultLayer.cs b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementResultLayer.cs
--- /dev/null
+++ b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementResultLayer.cs
@@ -0,0 +1,36 @@
+using Esri.ArcGISRuntime.Geometry;
+using Esri.ArcGISRuntime.Symbology;
+using Esri.ArcGISRuntime.UI;
+
+namespace WG.MiEditor.Core.Services.Drawing.Measurement.Components;
+
+/// <summary>
+/// Owns the single result graphic a measurement shows on an overlay. It only ever removes the
+/// graphic it added itself, so it never disturbs anything else on the overlay.
+/// </summary>
+public sealed class MeasurementResultLayer(GraphicsOverlay overlay)
+{
+    private Graphic? current;
+
+    public bool HasResult => current is not null;
+
+    /// <summary>Replaces the current result. Null or empty geometries just clear it.</summary>
+    public void Show(Geometry? geometry, Symbol symbol)
+    {
+        Clear();
+
+        if (geometry is null || geometry.IsEmpty) return;
+
+        current = new Graphic(geometry, symbol);
+        overlay.Graphics.Add(current);
+    }
+
+    public void Clear()
+    {
+        if (current is null) return;
+
+        var graphic = current;
+        current = null;
+        overlay.Graphics.Remove(graphic);
+    }
+}
diff -ruN a/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementSymbols.cs b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementSymbols.cs
--- /dev/null
+++ b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/MeasurementSymbols.cs
@@ -0,0 +1,110 @@
+using Esri.ArcGISRuntime.Symbology;
+using WG.MiEditor.Logging.Abstractions;
+using WG.MiEditor.Models.Drawing;
+using Colour = System.Drawing.Color;
+
+namespace WG.MiEditor.Core.Services.Drawing.Measurement.Components;
+
+/// <summary>
+/// Builds the measurement result symbols from appsettings without ever throwing. A typo or a
+/// missing value in configuration logs a warning and falls back to a sensible default, instead
+/// of failing service construction and taking the whole measurement toolbar down with it.
+/// </summary>
+public static class MeasurementSymbols
+{
+    public static readonly Colour DefaultLineColour = Colour.FromArgb(255, 0, 112, 255);
+    public static readonly Colour DefaultFillColour = Colour.FromArgb(64, 0, 112, 255);
+    public const double DefaultLineWidth = 2;
+
+    public static SimpleLineSymbol Line(
+        LineSymbolSetting? setting,
+        IDrawingSymbolColourParser colourParser,
+        ILoggerService logger,
+        string settingName)
+    {
+        var style = ParseStyle(setting?.Style, SimpleLineSymbolStyle.Solid, $"{settingName}.Style", logger);
+        var colour = ParseColour(setting?.Colour, DefaultLineColour, $"{settingName}.Colour", colourParser, logger);
+        var width = ValidWidth(setting?.Width, $"{settingName}.Width", logger);
+
+        return new SimpleLineSymbol(style, colour, width);
+    }
+
+    public static SimpleFillSymbol Polygon(
+        PolygonSymbolSetting? setting,
+        IDrawingSymbolColourParser colourParser,
+        ILoggerService logger,
+        string settingName)
+    {
+        var outline = Line(setting?.Outline, colourParser, logger, $"{settingName}.Outline");
+        var fillStyle = ParseStyle(setting?.FillStyle, SimpleFillSymbolStyle.Solid, $"{settingName}.FillStyle", logger);
+        var fillColour = ParseColour(setting?.FillColour, DefaultFillColour, $"{settingName}.FillColour", colourParser, logger);
+
+        return new SimpleFillSymbol(fillStyle, fillColour, outline);
+    }
+
+    /// <summary>
+    /// Case-insensitive enum parse that only accepts defined names, so "5" or "Soild" fall back
+    /// to <paramref name="fallback"/> with a warning rather than producing an undefined value.
+    /// </summary>
+    public static TEnum ParseStyle<TEnum>(string? value, TEnum fallback, string settingName, ILoggerService logger)
+        where TEnum : struct, Enum
+    {
+        if (!string.IsNullOrWhiteSpace(value) &&
+            !value.Trim().All(c => char.IsDigit(c) || c == '-') &&
+            Enum.TryParse<TEnum>(value.Trim(), ignoreCase: true, out var parsed) &&
+            Enum.IsDefined(parsed))
+        {
+            return parsed;
+        }
+
+        Warn(logger, $"Measurement symbol setting '{settingName}' has an unrecognised value '{value}'. Using '{fallback}'.");
+        return fallback;
+    }
+
+    public static Colour ParseColour(
+        ColourSetting? setting,
+        Colour fallback,
+        string settingName,
+        IDrawingSymbolColourParser colourParser,
+        ILoggerService logger)
+    {
+        if (setting is not null)
+        {
+            try
+            {
+                return colourParser.FromSetting(setting);
+            }
+            catch (Exception ex)
+            {
+                Warn(logger, $"Measurement symbol setting '{settingName}' is not a valid colour ({ex.Message}). Using the default.");
+                return fallback;
+            }
+        }
+
+        Warn(logger, $"Measurement symbol setting '{settingName}' is missing. Using the default.");
+        return fallback;
+    }
+
+    private static double ValidWidth(double? width, string settingName, ILoggerService logger)
+    {
+        if (width is { } value && double.IsFinite(value) && value > 0)
+        {
+            return value;
+        }
+
+        Warn(logger, $"Measurement symbol setting '{settingName}' has an invalid width '{width}'. Using {DefaultLineWidth}.");
+        return DefaultLineWidth;
+    }
+
+    private static void Warn(ILoggerService logger, string message)
+    {
+        try
+        {
+            logger.Warn(message);
+        }
+        catch
+        {
+            // A logging failure must not stop the symbol from being built.
+        }
+    }
+}
diff -ruN a/Src/MiEditor.Core/Services/Drawing/Measurement/Components/SketchMeasurement.cs b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/SketchMeasurement.cs
--- /dev/null
+++ b/Src/MiEditor.Core/Services/Drawing/Measurement/Components/SketchMeasurement.cs
@@ -0,0 +1,236 @@
+using CommunityToolkit.Mvvm.Messaging;
+using Esri.ArcGISRuntime.Geometry;
+using Esri.ArcGISRuntime.Maui;
+using Esri.ArcGISRuntime.Symbology;
+using Esri.ArcGISRuntime.UI.Editing;
+using System.ComponentModel;
+using WG.MiEditor.Core.Services.Drawing.Measurement.Context;
+
+namespace WG.MiEditor.Core.Services.Drawing.Measurement.Components;
+
+/// <summary>Configuration for one kind of sketched measurement.</summary>
+/// <param name="Title">User-facing name, used for error notifications.</param>
+/// <param name="GeometryType">Geometry the editor sketches.</param>
+/// <param name="MinVertexCount">Vertices required before a sketch can be completed.</param>
+/// <param name="ResultSymbol">Symbol for the completed measurement.</param>
+/// <param name="OnInvalidGeometry">Called when the user completes a sketch with too few vertices.</param>
+public sealed record SketchMeasurementOptions(
+    string Title,
+    GeometryType GeometryType,
+    int MinVertexCount,
+    Symbol ResultSymbol,
+    Action OnInvalidGeometry);
+
+/// <summary>
+/// A geometry-editor driven measurement: the user taps vertices, live length/area is broadcast as
+/// <see cref="Shared.Messages.Measurement.DrawingProgressMessage"/>, and a double-tap completes the
+/// sketch, leaving the result on the map until the next sketch begins.
+/// <para>
+/// Pan and zoom are locked only while a sketch has at least one vertex, so dragging a vertex
+/// cannot move the map and the completing double-tap cannot zoom it. Before the first vertex and
+/// between measurements the map is free to pan and zoom.
+/// </para>
+/// <para>
+/// Composed from <see cref="MapInteractionLock"/> (pan/zoom) and <see cref="MeasurementResultLayer"/>
+/// (result graphic). Every session is fully torn down by <see cref="Stop"/>, even when individual
+/// steps fail, and a failed <see cref="Start"/> leaves nothing attached.
+/// </para>
+/// </summary>
+public sealed class SketchMeasurement(
+    IMessenger messenger,
+    IMeasurementErrorReporter errorReporter,
+    SketchMeasurementOptions options)
+{
+    private readonly MapInteractionLock interactionLock = new();
+
+    private MapView? mapView;
+    private GeometryEditor? editor;
+    private MeasurementResultLayer? results;
+
+    // The map has one geometry editor shared by every drawing tool, and each tool assigns its own
+    // VertexTool instance when it starts. Comparing against ours tells us whether the running
+    // session is this measurement's, so we never react to, or stop, another tool's drawing.
+    private VertexTool? ownTool;
+
+    // Set when a sketch completes. The result stays visible until the user places the first
+    // vertex of the next sketch, at which point only the result graphic is removed.
+    private bool clearResultOnNextVertex;
+
+    // True while a double-tap is stopping and restarting the editor. The editor raises geometry
+    // changes during that, which must not be mistaken for the user undoing their vertices.
+    private bool completingSketch;
+
+    public bool IsRunning => mapView is not null;
+
+    public void Start(MeasurementContext context)
+    {
+        ArgumentNullException.ThrowIfNull(context);
+
+        if (IsRunning) Stop();
+
+        var geometryEditor = context.MapView.GeometryEditor
+            ?? throw new MeasurementUnavailableException("The map cannot be measured on right now. Please try again in a moment.");
+
+        mapView = context.MapView;
+        editor = geometryEditor;
+        results = new MeasurementResultLayer(context.Overlay);
+
+        try
+        {
+            ownTool = CreateVertexTool();
+
+            // Anything still drawing should have been stopped by its own toolbar through the
+            // activation coordinator; this only clears a stale session so Start cannot throw.
+            if (geometryEditor.IsStarted) geometryEditor.Stop();
+
+            geometryEditor.Tool = ownTool;
+            geometryEditor.PropertyChanged += OnEditorPropertyChanged;
+            context.MapView.GeoViewDoubleTapped += OnDoubleTapped;
+
+            geometryEditor.Start(options.GeometryType);
+        }
+        catch
+        {
+            try { Stop(); } catch { /* the original failure is the one worth reporting */ }
+            throw;
+        }
+    }
+
+    public void Stop()
+    {
+        if (!IsRunning) return;
+
+        var view = mapView!;
+        var geometryEditor = editor!;
+        var resultLayer = results;
+        var owned = OwnsSession(geometryEditor);
+
+        mapView = null;
+        editor = null;
+        results = null;
+        ownTool = null;
+        clearResultOnNextVertex = false;
+
+        CleanupSteps.RunAll(
+            () => view.GeoViewDoubleTapped -= OnDoubleTapped,
+            () => geometryEditor.PropertyChanged -= OnEditorPropertyChanged,
+            () => { if (owned) geometryEditor.Stop(); },
+            () => resultLayer?.Clear(),
+            interactionLock.Release);
+    }
+
+    private void OnDoubleTapped(object? sender, GeoViewInputEventArgs e)
+    {
+        var geometryEditor = editor;
+        var current = geometryEditor?.Geometry;
+        if (geometryEditor is null || !OwnsSession(geometryEditor) || current is null || current.IsEmpty || current.GeometryType != options.GeometryType)
+        {
+            // No sketch of ours in progress: leave the double-tap to the map (so it can zoom) or
+            // to whichever tool is drawing.
+            return;
+        }
+
+        e.Handled = true;
+
+        completingSketch = true;
+        try
+        {
+            var sketch = geometryEditor.Stop();
+
+            // The sketch is finished: free the map so the user can pan or zoom before the next one.
+            interactionLock.Release();
+
+            if (!MeasurementGeometry.HasMinimumVertices(sketch, options.MinVertexCount))
+            {
+                options.OnInvalidGeometry();
+                messenger.Send(MeasurementGeometry.Empty(options.GeometryType));
+            }
+            else
+            {
+                results?.Show(sketch, options.ResultSymbol);
+                clearResultOnNextVertex = true;
+            }
+
+            geometryEditor.Start(options.GeometryType);
+        }
+        catch (Exception ex)
+        {
+            errorReporter.Report(options.Title, ex);
+        }
+        finally
+        {
+            completingSketch = false;
+        }
+    }
+
+    private void OnEditorPropertyChanged(object? sender, PropertyChangedEventArgs e)
+    {
+        if (e.PropertyName != nameof(GeometryEditor.Geometry)) return;
+
+        try
+        {
+            var view = mapView;
+            var geometryEditor = editor;
+            if (view is null || geometryEditor is null) return;
+
+            if (!OwnsSession(geometryEditor))
+            {
+                // Another tool has taken the editor: do not measure its drawing or hold the map.
+                interactionLock.Release();
+                return;
+            }
+
+            var geometry = geometryEditor.Geometry;
+
+            if (geometry is null || geometry.IsEmpty)
+            {
+                // No vertices (new sketch, or the user undid them all): leave the map free.
+                interactionLock.Release();
+
+                // If the user undid their vertices, reset the live readings to zero. Straight after
+                // a completed sketch the panel keeps showing that result until the next one starts.
+                if (!clearResultOnNextVertex && !completingSketch)
+                {
+                    messenger.Send(MeasurementGeometry.Empty(options.GeometryType));
+                }
+
+                return;
+            }
+
+            // First vertex of a sketch: lock until it is completed. Idempotent for later vertices.
+            interactionLock.Lock(view);
+
+            if (clearResultOnNextVertex)
+            {
+                // Remove the previous result only. The editor's geometry is left alone: it now
+                // holds the vertex the user just placed.
+                clearResultOnNextVertex = false;
+                results?.Clear();
+            }
+
+            if (MeasurementGeometry.Measure(geometry) is { } progress)
+            {
+                messenger.Send(progress);
+            }
+        }
+        catch (Exception ex)
+        {
+            errorReporter.Report(options.Title, ex);
+        }
+    }
+
+    private bool OwnsSession(GeometryEditor geometryEditor) =>
+        ownTool is not null && geometryEditor.IsStarted && ReferenceEquals(geometryEditor.Tool, ownTool);
+
+    private static VertexTool CreateVertexTool() => new()
+    {
+        Style = new GeometryEditorStyle
+        {
+            VertexSymbol = new SimpleMarkerSymbol(SimpleMarkerSymbolStyle.Circle, System.Drawing.Color.Red, 6),
+            SelectedVertexSymbol = new SimpleMarkerSymbol(SimpleMarkerSymbolStyle.Circle, System.Drawing.Color.Red, 6),
+            SelectedMidVertexSymbol = new SimpleMarkerSymbol(SimpleMarkerSymbolStyle.Circle, System.Drawing.Color.Red, 6),
+            MidVertexSymbol = new SimpleMarkerSymbol(SimpleMarkerSymbolStyle.Square, System.Drawing.Color.Red, 6),
+            VertexTextSymbol = null
+        }
+    };
+}
