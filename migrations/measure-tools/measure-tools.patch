+        mapViewService.Setup(s => s.GetMapViewAsync()).Returns(new TaskCompletionSource<MapView>().Task);
+
+        var sut = new MapViewMeasurementContextProvider(mapViewService.Object, TimeSpan.FromMilliseconds(50));
