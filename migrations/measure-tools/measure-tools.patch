+        var overlay = new GraphicsOverlay();
+
+        MapViewMeasurementContextProvider.EnsureAttached(overlays, overlay);
+        MapViewMeasurementContextProvider.EnsureAttached(overlays, overlay);
+
+        Assert.Single(overlays);
+    }
+}
