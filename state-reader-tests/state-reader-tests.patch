diff --git a/Tests/MiEditor.Core.Tests/Services/Drawing/Editing/History/StateManagement/FeatureStateReaderTests.cs b/Tests/MiEditor.Core.Tests/Services/Drawing/Editing/History/StateManagement/FeatureStateReaderTests.cs
